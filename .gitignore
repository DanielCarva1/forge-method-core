.forge-method/*.local
.forge-method/test-runs/
.forge-method/claims-active/
.forge-method/locks/
.forge-method/traces/
.forge-method/handoffs/
.forge-method/wal/
# The consumer-project link file (.forge-method.yaml) points at a sibling
# sidecar that only exists on the local machine (../forge-<project>). It is
# local dogfood state and must not be committed — the release CI's
# `validate --root .` smoke test fails when it resolves an external sidecar
# that is absent from the checkout.
.forge-method.yaml
# Optional local validator exclusions. This is operator-local scope, not
# repository policy, and must not be shared as product authority.
.forgeignore
