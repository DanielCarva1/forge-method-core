{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge",
  "version": "0.1.0",
  "identifier": "com.stablestudio.forge",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "Forge", "width": 1180, "height": 820,
      "minWidth": 360, "minHeight": 480
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Stable Studio",
    "category": "DeveloperTool",
    "shortDescription": "Desktop companion for Forge projects",
    "longDescription": "A Windows desktop companion for working with existing Forge projects through a supported Codex CLI installation.",
    "homepage": "https://github.com/DanielCarva1/forge-method-core",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
