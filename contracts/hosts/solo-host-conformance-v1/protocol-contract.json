{
  "contract_version": "solo_host_conformance_protocol_contract_v1",
  "protocol_version": "solo_host_conformance_protocol_v1",
  "transport": {
    "invocation": "separated_argv_without_shell",
    "working_directory": "forge_resolved_canonical_project_root",
    "request": "one_utf8_json_document_on_stdin",
    "response": "one_utf8_json_document_on_stdout",
    "stderr": "drained_but_never_disclosed",
    "default_timeout_ms": 30000,
    "maximum_timeout_ms": 300000,
    "maximum_stdout_bytes": 4194304,
    "maximum_stderr_bytes": 4194304
  },
  "request": {
    "required_fields": ["schema_version", "bindings", "accepted_native_proof_schemes", "cases"],
    "bindings_rule": "declared labels are separate from Forge-observed facts and must be copied exactly",
    "proof_rule": "an empty accepted_native_proof_schemes list means adapter proof claims are not accepted",
    "case_rule": "exactly one case for each of the eight public capabilities"
  },
  "response": {
    "required_fields": ["schema_version", "bindings", "cases"],
    "case_required_fields": ["case_id", "assertions", "gaps", "evidence"],
    "assertion_value": {
      "required_fields": ["passed", "native_proof_claim"],
      "passed_type": "boolean",
      "native_proof_claim": "null unless the request names an accepted proof scheme"
    },
    "gap_value": {
      "required_fields": ["kind", "code"],
      "message_or_free_text_forbidden": true
    },
    "evidence_value": {
      "required_fields": ["fact_codes"],
      "fact_codes": "one to thirty-two unique safe tokens",
      "raw_chat_transcript_logs_environment_and_arbitrary_content_forbidden": true
    },
    "final_support_label_forbidden": true,
    "unknown_fields_forbidden": true
  },
  "forge_derivation": {
    "outcomes": ["supported", "partially_supported", "unsupported"],
    "adapter_report_alone_can_be_supported": false,
    "unverified_pass_is_capped_at": "partially_supported",
    "tampered_incomplete_or_unsafe_bundle": "invalid_not_unsupported",
    "windows_to_wsl_values": ["applicable", "not_applicable", "indeterminate"]
  },
  "bundle": {
    "required_files": ["manifest.json", "request.json", "response.json", "result.json"],
    "artifact_path_rule": "artifacts/<case_id>.json generated by Forge from closed response fields",
    "links_forbidden": true,
    "maximum_directory_depth": 4,
    "maximum_payload_files": 64,
    "maximum_total_payload_bytes": 4194304
  }
}