      "case_id": "governed-promotion",
      "capability": "governed_promotion",
      "description": "A validated change is applied once, read back, and exact retry does not apply it twice.",
      "required_assertions": [
        "preview_bound_to_exact_change",
        "apply_read_back_matches",
        "exact_retry_is_idempotent"
      ]
